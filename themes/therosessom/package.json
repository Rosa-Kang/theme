{
  "name": "therosessom",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "npx tailwindcss -i ./src/input.css -o ./dist/main.css --minify",
    "watch:css": "npx tailwindcss -i ./src/input.css -o ./dist/main.css --watch",
    "serve": "browser-sync start --proxy 'localhost:8888' --files 'dist/*.css, **/*.php'",
    "dev": "npm-run-all --parallel watch:css serve"
  },
